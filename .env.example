# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=your_bot_token_here

# Строка подключения к PostgreSQL. Обязательный параметр.
# Для продакшена и удалённой БД используйте TLS: sslmode=require
# (или sslmode=verify-full, если настроен CA-сертификат).
# sslmode=disable — только для локальной разработки, когда SSL на
# сервере PostgreSQL не настроен.
# Формат: postgres://user:password@host:port/dbname?sslmode=require
# Например: postgres://taro:secret@127.0.0.1:5432/taro_bot?sslmode=require
DATABASE_URL=

# API-ключ DeepSeek для генерации прогнозов (https://platform.deepseek.com)
# Если не указан, ИИ-функции будут отвечать ошибкой
AI_API_KEY=

# Платёжный провайдер онлайн-оплаты (yukassa, robokassa, stripe, ...).
# Пока не выбран: оставьте пустым — бот работает в бесплатном режиме.
PAYMENT_PROVIDER=

# Тестовый режим: 1 — результат нумерологии приходит сразу,
# 0 (рабочий режим) — через случайные 1–2 часа.
TEST_MODE=0
